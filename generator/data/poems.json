[
 {
  "title": "在獄詠蟬",
  "author": "駱賓王",
  "author_roman": "LUO BINWANG",
  "author_dates": "640-684",
  "form": "五言律詩",
  "lines": [
   "西陸蟬聲唱",
   "南冠客思侵",
   "那堪玄鬢影",
   "來對白頭吟",
   "露重飛難進",
   "風多響易沈",
   "無人信高潔",
   "誰為表予心"
  ]
 },
 {
  "title": "經鄒魯祭孔子而歎之",
  "author": "明皇帝",
  "author_roman": "TANG XUANZONG",
  "author_dates": "685-762",
  "form": "五言律詩",
  "lines": [
   "夫子何為者",
   "栖栖一代中",
   "地猶鄹氏邑",
   "宅即魯王宮",
   "歎鳳嗟身否",
   "傷麟怨道窮",
   "今看兩楹奠",
   "當與夢時同"
  ]
 },
 {
  "title": "新嫁娘詞其三",
  "author": "王建",
  "author_roman": "WANG JIAN",
  "author_dates": "767-830",
  "form": "五言絕句",
  "lines": [
   "三日入廚下",
   "洗手作羹湯",
   "未諳姑食性",
   "先遣小姑嘗"
  ]
 },
 {
  "title": "故行宮",
  "author": "王建",
  "author_roman": "WANG JIAN",
  "author_dates": "767-830",
  "form": "五言絕句",
  "lines": [
   "寥落古行宮",
   "宮花寂寞紅",
   "白頭宮女在",
   "閑坐說玄宗"
  ]
 },
 {
  "title": "蟬",
  "author": "李商隱",
  "author_roman": "LI SHANGYIN",
  "author_dates": "813-858",
  "form": "五言律詩",
  "lines": [
   "本以高難飽",
   "徒勞恨費聲",
   "五更疎欲斷",
   "一樹碧無情",
   "薄宦梗猶汎",
   "故園蕪已平",
   "煩君最相警",
   "我亦舉家清"
  ]
 },
 {
  "title": "樂遊原",
  "author": "李商隱",
  "author_roman": "LI SHANGYIN",
  "author_dates": "813-858",
  "form": "五言絕句",
  "lines": [
   "向晚意不適",
   "驅車登古原",
   "夕陽無限好",
   "只是近黃昏"
  ]
 },
 {
  "title": "風雨",
  "author": "李商隱",
  "author_roman": "LI SHANGYIN",
  "author_dates": "813-858",
  "form": "五言律詩",
  "lines": [
   "淒涼寶劍篇",
   "羈泊欲窮年",
   "黃葉仍風雨",
   "青樓自管絃",
   "新知遭薄俗",
   "舊好隔良緣",
   "心斷新豐酒",
   "銷愁斗幾千"
  ]
 },
 {
  "title": "落花",
  "author": "李商隱",
  "author_roman": "LI SHANGYIN",
  "author_dates": "813-858",
  "form": "五言律詩",
  "lines": [
   "高閣客竟去",
   "小園花亂飛",
   "參差連曲陌",
   "迢遰送斜暉",
   "腸斷未忍掃",
   "眼穿仍欲歸",
   "芳心向春盡",
   "所得是沾衣"
  ]
 },
 {
  "title": "涼思",
  "author": "李商隱",
  "author_roman": "LI SHANGYIN",
  "author_dates": "813-858",
  "form": "五言律詩",
  "lines": [
   "客去波平檻",
   "蟬休露滿枝",
   "永懷當此節",
   "倚立自移時",
   "北斗兼春遠",
   "南陵寓使遲",
   "天涯占夢數",
   "疑誤有新知"
  ]
 },
 {
  "title": "北青蘿",
  "author": "李商隱",
  "author_roman": "LI SHANGYIN",
  "author_dates": "813-858",
  "form": "五言律詩",
  "lines": [
   "殘陽西入崦",
   "茅屋訪孤僧",
   "落葉人何在",
   "寒雲路幾層",
   "獨敲初夜磬",
   "閑倚一枝藤",
   "世界微塵裏",
   "吾寧愛與憎"
  ]
 },
 {
  "title": "章臺夜思",
  "author": "韋莊",
  "author_roman": "WEI ZHUANG",
  "author_dates": "836-910",
  "form": "五言律詩",
  "lines": [
   "清瑟怨遙夜",
   "遶弦風雨哀",
   "孤燈聞楚角",
   "殘月下章臺",
   "芳草已云暮",
   "故人殊未來",
   "鄉書不可寄",
   "秋雁又南迴"
  ]
 },
 {
  "title": "楚江懷古其一",
  "author": "馬戴",
  "author_roman": "MA DAI",
  "author_dates": "799-869",
  "form": "五言律詩",
  "lines": [
   "露氣寒光集",
   "微陽下楚丘",
   "猨啼洞庭樹",
   "人在木蘭舟",
   "廣澤生明月",
   "蒼山夾亂流",
   "雲中君不降",
   "竟夕自悲秋"
  ]
 },
 {
  "title": "灞上秋居",
  "author": "馬戴",
  "author_roman": "MA DAI",
  "author_dates": "799-869",
  "form": "五言律詩",
  "lines": [
   "灞原風雨定",
   "晚見鴈行頻",
   "落葉他鄉樹",
   "寒燈獨夜人",
   "空園白露滴",
   "孤壁野僧隣",
   "寄臥郊扉久",
   "何門致此身"
  ]
 },
 {
  "title": "沒蕃故人",
  "author": "張籍",
  "author_roman": "ZHANG JI",
  "author_dates": "766-830",
  "form": "五言律詩",
  "lines": [
   "前年伐月支",
   "城上沒全師",
   "蕃漢斷消息",
   "死生長別離",
   "無人收廢帳",
   "歸馬識殘旗",
   "欲祭疑君在",
   "天涯哭此時"
  ]
 },
 {
  "title": "春怨",
  "author": "金昌緒",
  "author_roman": "",
  "author_dates": "",
  "form": "五言絕句",
  "lines": [
   "打起黃鶯兒",
   "莫教枝上啼",
   "啼時驚妾夢",
   "不得到遼西"
  ]
 },
 {
  "title": "行宮",
  "author": "元稹",
  "author_roman": "YUAN ZHEN",
  "author_dates": "779-831",
  "form": "五言絕句",
  "lines": [
   "寥落古行宮",
   "宮花寂寞紅",
   "白頭宮女在",
   "閑坐說玄宗"
  ]
 },
 {
  "title": "哥舒歌",
  "author": "西鄙人",
  "author_roman": "",
  "author_dates": "",
  "form": "五言絕句",
  "lines": [
   "北斗七星高",
   "哥舒夜帶刀",
   "至今窺牧馬",
   "不敢過臨洮"
  ]
 },
 {
  "title": "雜詩其三",
  "author": "沈佺期",
  "author_roman": "SHEN QUANQI",
  "author_dates": "656-715",
  "form": "五言律詩",
  "lines": [
   "聞道黃龍戍",
   "頻年不解兵",
   "可憐閨裏月",
   "長在漢家營",
   "少婦今春意",
   "良人昨夜情",
   "誰能將旗鼓",
   "一為取龍城"
  ]
 },
 {
  "title": "次北固山下",
  "author": "王灣",
  "author_roman": "WANG WAN",
  "author_dates": "693-751",
  "form": "五言律詩",
  "lines": [
   "客路青山外",
   "行舟綠水前",
   "潮平兩岸闊",
   "風正一帆懸",
   "海日生殘夜",
   "江春入舊年",
   "鄉書何處達",
   "歸雁洛陽邊"
  ]
 },
 {
  "title": "輞川閑居贈裴秀才迪",
  "author": "王維",
  "author_roman": "WANG WEI",
  "author_dates": "701-761",
  "form": "五言律詩",
  "lines": [
   "寒山轉蒼翠",
   "秋水日潺湲",
   "倚杖柴門外",
   "臨風聽暮蟬",
   "渡頭餘落日",
   "墟里上孤煙",
   "復值接輿醉",
   "狂歌五柳前"
  ]
 },
 {
  "title": "酬張少府",
  "author": "王維",
  "author_roman": "WANG WEI",
  "author_dates": "701-761",
  "form": "五言律詩",
  "lines": [
   "晚年唯好靜",
   "萬事不關心",
   "自顧無長策",
   "空知返舊林",
   "松風吹解帶",
   "山月照彈琴",
   "君問窮通理",
   "漁歌入浦深"
  ]
 },
 {
  "title": "送梓州李使君",
  "author": "王維",
  "author_roman": "WANG WEI",
  "author_dates": "701-761",
  "form": "五言律詩",
  "lines": [
   "萬壑樹參天",
   "千山響杜鵑",
   "山中一夜雨",
   "樹杪百重泉",
   "漢女輸橦布",
   "巴人訟芋田",
   "文翁翻教授",
   "不敢倚先賢"
  ]
 },
 {
  "title": "春宮怨",
  "author": "杜荀鶴",
  "author_roman": "DU XUNHE",
  "author_dates": "846-904",
  "form": "五言律詩",
  "lines": [
   "早被嬋娟誤",
   "欲妝臨鏡慵",
   "承恩不在貌",
   "教妾若為容",
   "風暖鳥聲碎",
   "日高花影重",
   "年年越溪女",
   "相憶採芙蓉"
  ]
 },
 {
  "title": "旅宿",
  "author": "杜牧",
  "author_roman": "DU MU",
  "author_dates": "803-852",
  "form": "五言律詩",
  "lines": [
   "旅館無良伴",
   "凝情自悄然",
   "寒燈思舊事",
   "斷鴈警愁眠",
   "遠夢歸侵曉",
   "家書到隔年",
   "湘江好煙月",
   "門繫釣魚船"
  ]
 },
 {
  "title": "早秋其一",
  "author": "許渾",
  "author_roman": "XU HUN",
  "author_dates": "791-858",
  "form": "五言律詩",
  "lines": [
   "遙夜泛清瑟",
   "西風生翠蘿",
   "殘螢委玉露",
   "早鴈拂銀河",
   "高樹曉還密",
   "遠山晴更多",
   "淮南一葉下",
   "自覺老煙波"
  ]
 },
 {
  "title": "秋日赴闕題潼關驛樓",
  "author": "許渾",
  "author_roman": "XU HUN",
  "author_dates": "791-858",
  "form": "五言律詩",
  "lines": [
   "紅葉晚蕭蕭",
   "長亭酒一瓢",
   "殘雲歸太華",
   "疎雨過中條",
   "樹色隨山迥",
   "河聲入海遙",
   "帝鄉明日到",
   "猶自夢漁樵"
  ]
 },
 {
  "title": "喜見外弟又言別",
  "author": "李益",
  "author_roman": "LI YI",
  "author_dates": "748-829",
  "form": "五言律詩",
  "lines": [
   "十年離亂後",
   "長大一相逢",
   "問姓驚初見",
   "稱名憶舊容",
   "別來滄海事",
   "語罷暮天鐘",
   "明日巴陵道",
   "秋山又幾重"
  ]
 },
 {
  "title": "江南詞",
  "author": "李益",
  "author_roman": "LI YI",
  "author_dates": "748-829",
  "form": "樂府",
  "lines": [
   "嫁得瞿塘賈",
   "朝朝悞妾期",
   "早知潮有信",
   "嫁與弄潮兒"
  ]
 },
 {
  "title": "聽箏",
  "author": "李端",
  "author_roman": "LI DUAN",
  "author_dates": "743-782",
  "form": "五言絕句",
  "lines": [
   "鳴箏金粟柱",
   "素手玉房前",
   "欲得周郎顧",
   "時時誤拂弦"
  ]
 },
 {
  "title": "賊平後送人北歸",
  "author": "司空曙",
  "author_roman": "SIKONG SHU",
  "author_dates": "720-790",
  "form": "五言律詩",
  "lines": [
   "世亂同南去",
   "時清獨北還",
   "他鄉生白髮",
   "舊國見青山",
   "曉月過殘壘",
   "繁星宿故關",
   "寒禽與衰草",
   "處處伴愁顏"
  ]
 },
 {
  "title": "雲陽館與韓紳宿別",
  "author": "司空曙",
  "author_roman": "SIKONG SHU",
  "author_dates": "720-790",
  "form": "五言律詩",
  "lines": [
   "故人江海別",
   "幾度隔山川",
   "乍見翻疑夢",
   "相悲各問年",
   "孤燈寒照雨",
   "溼竹暗浮煙",
   "更有明朝恨",
   "離杯惜共傳"
  ]
 },
 {
  "title": "喜外弟盧綸見宿",
  "author": "司空曙",
  "author_roman": "SIKONG SHU",
  "author_dates": "720-790",
  "form": "五言律詩",
  "lines": [
   "靜夜四無鄰",
   "荒居舊業貧",
   "雨中黃葉樹",
   "燈下白頭人",
   "以我獨沈久",
   "愧君相見頻",
   "平生自有分",
   "況是蔡家親"
  ]
 },
 {
  "title": "聽彈琴",
  "author": "劉長卿",
  "author_roman": "LIU CHANGQING",
  "author_dates": "709-785",
  "form": "五言絕句",
  "lines": [
   "泠泠七絲上",
   "靜聽松風寒",
   "古調雖自愛",
   "今人多不彈"
  ]
 },
 {
  "title": "送方外上人",
  "author": "劉長卿",
  "author_roman": "LIU CHANGQING",
  "author_dates": "709-785",
  "form": "五言絕句",
  "lines": [
   "孤雲將野鶴",
   "豈向人間住",
   "莫買沃洲山",
   "時人已知處"
  ]
 },
 {
  "title": "送靈澈上人",
  "author": "劉長卿",
  "author_roman": "LIU CHANGQING",
  "author_dates": "709-785",
  "form": "五言絕句",
  "lines": [
   "蒼蒼竹林寺",
   "杳杳鐘聲晚",
   "荷笠帶夕陽",
   "青山獨歸遠"
  ]
 },
 {
  "title": "新年作",
  "author": "劉長卿",
  "author_roman": "LIU CHANGQING",
  "author_dates": "709-785",
  "form": "五言律詩",
  "lines": [
   "鄉心新歲切",
   "天畔獨潸然",
   "老至居人下",
   "春歸在客先",
   "嶺猨同旦暮",
   "江柳共風煙",
   "已是長沙傅",
   "從今又幾年"
  ]
 },
 {
  "title": "尋南溪常山道人隱居",
  "author": "劉長卿",
  "author_roman": "LIU CHANGQING",
  "author_dates": "709-785",
  "form": "五言律詩",
  "lines": [
   "一路經行處",
   "莓苔見履痕",
   "白雲依靜渚",
   "春草閉閑門",
   "過雨看松色",
   "隨山到水源",
   "溪花與禪意",
   "相對亦忘言"
  ]
 },
 {
  "title": "餞別王十一南遊",
  "author": "劉長卿",
  "author_roman": "LIU CHANGQING",
  "author_dates": "709-785",
  "form": "五言律詩",
  "lines": [
   "望君煙水闊",
   "揮手淚霑巾",
   "飛鳥沒何處",
   "青山空向人",
   "長江一帆遠",
   "落日五湖春",
   "誰見汀洲上",
   "相思愁白蘋"
  ]
 },
 {
  "title": "望洞庭湖贈張丞相",
  "author": "孟浩然",
  "author_roman": "MENG HAORAN",
  "author_dates": "689-740",
  "form": "五言律詩",
  "lines": [
   "八月湖水平",
   "涵虛混太清",
   "氣蒸雲夢澤",
   "波撼岳陽城",
   "欲濟無舟楫",
   "端居恥聖明",
   "坐觀垂釣者",
   "空有羨魚情"
  ]
 },
 {
  "title": "秦中感秋寄遠上人",
  "author": "孟浩然",
  "author_roman": "MENG HAORAN",
  "author_dates": "689-740",
  "form": "五言律詩",
  "lines": [
   "一丘常欲臥",
   "三徑苦無資",
   "北土非吾願",
   "東林懷我師",
   "黃金然桂盡",
   "壯志逐年衰",
   "日夕涼風至",
   "聞蟬但益悲"
  ]
 },
 {
  "title": "宿桐廬江寄廣陵舊遊",
  "author": "孟浩然",
  "author_roman": "MENG HAORAN",
  "author_dates": "689-740",
  "form": "五言律詩",
  "lines": [
   "山暝聞猿愁",
   "滄江急夜流",
   "風鳴兩岸葉",
   "月照一孤舟",
   "建德非吾土",
   "維揚憶舊遊",
   "還將兩行淚",
   "遙寄海西頭"
  ]
 },
 {
  "title": "早寒江上有懷",
  "author": "孟浩然",
  "author_roman": "MENG HAORAN",
  "author_dates": "689-740",
  "form": "五言律詩",
  "lines": [
   "木落雁南度",
   "北風江上寒",
   "我家襄水上",
   "遙隔楚雲端",
   "鄉淚客中盡",
   "孤帆天際看",
   "迷津欲有問",
   "平海夕漫漫"
  ]
 },
 {
  "title": "留別王侍御維",
  "author": "孟浩然",
  "author_roman": "MENG HAORAN",
  "author_dates": "689-740",
  "form": "五言律詩",
  "lines": [
   "寂寂竟何待",
   "朝朝空自歸",
   "欲尋芳草去",
   "惜與故人違",
   "當路誰相假",
   "知音世所稀",
   "秪應守索寞",
   "還掩故園扉"
  ]
 },
 {
  "title": "清明日宴梅道士房",
  "author": "孟浩然",
  "author_roman": "MENG HAORAN",
  "author_dates": "689-740",
  "form": "五言律詩",
  "lines": [
   "林臥愁春盡",
   "開軒覽物華",
   "忽逢青鳥使",
   "邀入赤松家",
   "丹竈初開火",
   "仙桃正落花",
   "童顏若可駐",
   "何惜醉流霞"
  ]
 },
 {
  "title": "與諸子登峴山",
  "author": "孟浩然",
  "author_roman": "MENG HAORAN",
  "author_dates": "689-740",
  "form": "五言律詩",
  "lines": [
   "人事有代謝",
   "往來成古今",
   "江山留勝跡",
   "我輩復登臨",
   "水落魚梁淺",
   "天寒夢澤深",
   "羊公碑字在",
   "讀罷淚沾襟"
  ]
 },
 {
  "title": "過故人莊",
  "author": "孟浩然",
  "author_roman": "MENG HAORAN",
  "author_dates": "689-740",
  "form": "五言律詩",
  "lines": [
   "故人具雞黍",
   "邀我至田家",
   "綠樹村邊合",
   "青山郭外斜",
   "開筵面場圃",
   "把酒話桑麻",
   "待到重陽日",
   "還來就菊花"
  ]
 },
 {
  "title": "歲暮歸南山",
  "author": "孟浩然",
  "author_roman": "MENG HAORAN",
  "author_dates": "689-740",
  "form": "五言律詩",
  "lines": [
   "北闕休上書",
   "南山歸敝廬",
   "不才明主棄",
   "多病故人疎",
   "白髮催年老",
   "青陽逼歲除",
   "永懷愁不寐",
   "松月夜窗虛"
  ]
 },
 {
  "title": "歲除夜有懷",
  "author": "孟浩然",
  "author_roman": "MENG HAORAN",
  "author_dates": "689-740",
  "form": "五言律詩",
  "lines": [
   "迢遞三巴路",
   "羈危萬里身",
   "亂山殘雪夜",
   "孤燈異鄉人",
   "漸與骨肉遠",
   "轉於奴僕親",
   "那堪正飄泊",
   "來日歲華新"
  ]
 },
 {
  "title": "春曉",
  "author": "孟浩然",
  "author_roman": "MENG HAORAN",
  "author_dates": "689-740",
  "form": "五言絕句",
  "lines": [
   "春眠不覺曉",
   "處處聞啼鳥",
   "夜來風雨聲",
   "花落知多少"
  ]
 },
 {
  "title": "宿建德江",
  "author": "孟浩然",
  "author_roman": "MENG HAORAN",
  "author_dates": "689-740",
  "form": "五言絕句",
  "lines": [
   "移舟泊煙渚",
   "日暮客愁新",
   "野曠天低樹",
   "江清月近人"
  ]
 },
 {
  "title": "客夜與故人偶集",
  "author": "戴叔倫",
  "author_roman": "DAI SHULUN",
  "author_dates": "732-789",
  "form": "五言律詩",
  "lines": [
   "天秋月又滿",
   "城闕夜千重",
   "還作江南會",
   "翻疑夢裏逢",
   "風枝驚暗鵲",
   "露草覆寒蛩",
   "羈旅長堪醉",
   "相留畏曉鐘"
  ]
 },
 {
  "title": "和張僕射塞下曲其一",
  "author": "盧綸",
  "author_roman": "LU LUN",
  "author_dates": "739-799",
  "form": "樂府",
  "lines": [
   "鷲翎金僕姑",
   "燕尾繡蝥弧",
   "獨立揚新令",
   "千營共一呼"
  ]
 },
 {
  "title": "和張僕射塞下曲其二",
  "author": "盧綸",
  "author_roman": "LU LUN",
  "author_dates": "739-799",
  "form": "樂府",
  "lines": [
   "林暗草驚風",
   "將軍夜引弓",
   "平明尋白羽",
   "沒在石稜中"
  ]
 },
 {
  "title": "和張僕射塞下曲其三",
  "author": "盧綸",
  "author_roman": "LU LUN",
  "author_dates": "739-799",
  "form": "樂府",
  "lines": [
   "月黑鴈飛高",
   "單于夜遁逃",
   "欲將輕騎逐",
   "大雪滿弓刀"
  ]
 },
 {
  "title": "和張僕射塞下曲其四",
  "author": "盧綸",
  "author_roman": "LU LUN",
  "author_dates": "739-799",
  "form": "樂府",
  "lines": [
   "野幕敞瓊筵",
   "羌戎賀勞旋",
   "醉和金甲舞",
   "雷鼓動山川"
  ]
 },
 {
  "title": "李端公",
  "author": "盧綸",
  "author_roman": "LU LUN",
  "author_dates": "739-799",
  "form": "五言律詩",
  "lines": [
   "故關衰草遍",
   "離別自堪悲",
   "路出寒雲外",
   "人歸暮雪時",
   "少孤為客早",
   "多難識君遲",
   "掩淚空相向",
   "風塵何處期"
  ]
 },
 {
  "title": "過香積寺",
  "author": "王維",
  "author_roman": "WANG WEI",
  "author_dates": "701-761",
  "form": "五言律詩",
  "lines": [
   "不知香積寺",
   "數里入雲峰",
   "古木無人逕",
   "深山何處鐘",
   "泉聲咽危石",
   "日色冷青松",
   "薄暮空潭曲",
   "安禪制毒龍"
  ]
 },
 {
  "title": "山居秋暝",
  "author": "王維",
  "author_roman": "WANG WEI",
  "author_dates": "701-761",
  "form": "五言律詩",
  "lines": [
   "空山新雨後",
   "天氣晚來秋",
   "明月松間照",
   "清泉石上流",
   "竹喧歸浣女",
   "蓮動下漁舟",
   "隨意春芳歇",
   "王孫自可留"
  ]
 },
 {
  "title": "終南別業",
  "author": "王維",
  "author_roman": "WANG WEI",
  "author_dates": "701-761",
  "form": "五言律詩",
  "lines": [
   "中歲頗好道",
   "晚家南山陲",
   "興來每獨往",
   "勝事空自知",
   "行到水窮處",
   "坐看雲起時",
   "偶然值林叟",
   "談笑無還期"
  ]
 },
 {
  "title": "歸嵩山作",
  "author": "王維",
  "author_roman": "WANG WEI",
  "author_dates": "701-761",
  "form": "五言律詩",
  "lines": [
   "清川帶長薄",
   "車馬去閑閑",
   "流水如有意",
   "暮禽相與還",
   "荒城臨古渡",
   "落日滿秋山",
   "迢遞嵩高下",
   "歸來且閉關"
  ]
 },
 {
  "title": "終南山",
  "author": "王維",
  "author_roman": "WANG WEI",
  "author_dates": "701-761",
  "form": "五言律詩",
  "lines": [
   "太乙近天都",
   "連山接海隅",
   "白雲迴望合",
   "青靄入看無",
   "分野中峰變",
   "陰晴眾壑殊",
   "欲投人處宿",
   "隔水問樵夫"
  ]
 },
 {
  "title": "漢江臨汎",
  "author": "王維",
  "author_roman": "WANG WEI",
  "author_dates": "701-761",
  "form": "五言律詩",
  "lines": [
   "楚塞三湘接",
   "荊門九派通",
   "江流天地外",
   "山色有無中",
   "郡邑浮前浦",
   "波瀾動遠空",
   "襄陽好風日",
   "留醉與山翁"
  ]
 },
 {
  "title": "鹿柴",
  "author": "王維",
  "author_roman": "WANG WEI",
  "author_dates": "701-761",
  "form": "五言絕句",
  "lines": [
   "空山不見人",
   "但聞人語響",
   "返景入深林",
   "復照青苔上"
  ]
 },
 {
  "title": "竹里館",
  "author": "王維",
  "author_roman": "WANG WEI",
  "author_dates": "701-761",
  "form": "五言絕句",
  "lines": [
   "獨坐幽篁裏",
   "彈琴復長嘯",
   "深林人不知",
   "明月來相照"
  ]
 },
 {
  "title": "送別",
  "author": "王維",
  "author_roman": "WANG WEI",
  "author_dates": "701-761",
  "form": "五言絕句",
  "lines": [
   "山中相送罷",
   "日暮掩柴扉",
   "春草明年綠",
   "王孫歸不歸"
  ]
 },
 {
  "title": "雜詩其二",
  "author": "王維",
  "author_roman": "WANG WEI",
  "author_dates": "701-761",
  "form": "五言絕句",
  "lines": [
   "君自故鄉來",
   "應知故鄉事",
   "來日綺窗前",
   "寒梅着花未"
  ]
 },
 {
  "title": "相思",
  "author": "王維",
  "author_roman": "WANG WEI",
  "author_dates": "701-761",
  "form": "五言絕句",
  "lines": [
   "紅豆生南國",
   "秋來發故枝",
   "願君多采擷",
   "此物最相思"
  ]
 },
 {
  "title": "長干曲其一",
  "author": "崔顥",
  "author_roman": "CUI HAO",
  "author_dates": "704-754",
  "form": "樂府",
  "lines": [
   "君家何處住",
   "妾住在橫塘",
   "停船暫借問",
   "或恐是同鄉"
  ]
 },
 {
  "title": "長干曲其二",
  "author": "崔顥",
  "author_roman": "CUI HAO",
  "author_dates": "704-754",
  "form": "樂府",
  "lines": [
   "家臨九江水",
   "來去九江側",
   "同是長干人",
   "自小不相識"
  ]
 },
 {
  "title": "終南望餘雪",
  "author": "祖詠",
  "author_roman": "ZU YONG",
  "author_dates": "699-746",
  "form": "五言絕句",
  "lines": [
   "終南陰嶺秀",
   "積雪浮雲端",
   "林表明霽色",
   "城中增暮寒"
  ]
 },
 {
  "title": "塞下曲其一",
  "author": "王昌齡",
  "author_roman": "WANG CHANGLING",
  "author_dates": "698-756",
  "form": "樂府",
  "lines": [
   "蟬鳴空桑林",
   "八月蕭關道",
   "出塞入塞寒",
   "處處黃蘆草",
   "從來幽并客",
   "皆共塵沙老",
   "莫學遊俠兒",
   "矜夸紫騮好"
  ]
 },
 {
  "title": "塞下曲其二",
  "author": "王昌齡",
  "author_roman": "WANG CHANGLING",
  "author_dates": "698-756",
  "form": "樂府",
  "lines": [
   "飲馬渡秋水",
   "水寒風似刀",
   "平沙日未沒",
   "黯黯見臨洮",
   "昔日長城戰",
   "咸言意氣高",
   "黃塵足今古",
   "白骨亂蓬蒿"
  ]
 },
 {
  "title": "宿王昌齡隱居",
  "author": "常建",
  "author_roman": "",
  "author_dates": "",
  "form": "五言古詩",
  "lines": [
   "清溪深不測",
   "隱處唯孤雲",
   "松際露微月",
   "清光猶為君",
   "茅亭宿花影",
   "藥院滋苔紋",
   "余亦謝時去",
   "西山鸞鶴羣"
  ]
 },
 {
  "title": "賦得古原草送別",
  "author": "白居易",
  "author_roman": "BAI JUYI",
  "author_dates": "772-846",
  "form": "五言律詩",
  "lines": [
   "離離原上草",
   "一歲一枯榮",
   "野火燒不盡",
   "春風吹又生",
   "遠芳侵古道",
   "晴翠接荒城",
   "又送王孫去",
   "萋萋滿別情"
  ]
 },
 {
  "title": "問劉十九",
  "author": "白居易",
  "author_roman": "BAI JUYI",
  "author_dates": "772-846",
  "form": "五言絕句",
  "lines": [
   "綠螘新醅酒",
   "紅泥小火壚",
   "晚來天欲雪",
   "能飲一杯無"
  ]
 },
 {
  "title": "尋隱者不遇",
  "author": "賈島",
  "author_roman": "JIA DAO",
  "author_dates": "779-843",
  "form": "五言絕句",
  "lines": [
   "松下問童子",
   "言師採藥去",
   "只在此山中",
   "雲深不知處"
  ]
 },
 {
  "title": "送人東遊",
  "author": "溫庭筠",
  "author_roman": "WEN TINGYUN",
  "author_dates": "812-870",
  "form": "五言律詩",
  "lines": [
   "荒戍落黃葉",
   "浩然離故關",
   "高風漢陽渡",
   "初日郢門山",
   "江上幾人在",
   "天涯孤櫂還",
   "何當重相見",
   "尊酒慰離顏"
  ]
 },
 {
  "title": "渡漢江",
  "author": "李頻",
  "author_roman": "LI PIN",
  "author_dates": "818-876",
  "form": "五言絕句",
  "lines": [
   "嶺外音書絕",
   "經年復歷春",
   "近鄉情更怯",
   "不敢問來人"
  ]
 },
 {
  "title": "春宮怨",
  "author": "周朴",
  "author_roman": "",
  "author_dates": "",
  "form": "五言律詩",
  "lines": [
   "早被嬋娟誤",
   "欲妝臨鏡慵",
   "承恩不在貌",
   "教妾若為容",
   "風暖鳥聲碎",
   "日高花影重",
   "年年越溪女",
   "相憶采芙蓉"
  ]
 },
 {
  "title": "孤鴈其二",
  "author": "崔塗",
  "author_roman": "",
  "author_dates": "",
  "form": "五言律詩",
  "lines": [
   "幾行歸去盡",
   "片影獨何之",
   "暮雨相呼失",
   "寒塘獨下遲",
   "渚雲低暗度",
   "關月冷遙隨",
   "未必逢矰繳",
   "孤飛自可疑"
  ]
 },
 {
  "title": "巴山道中除夜書懷",
  "author": "崔塗",
  "author_roman": "",
  "author_dates": "",
  "form": "五言律詩",
  "lines": [
   "迢遰三巴路",
   "羇危萬里身",
   "亂山殘雪夜",
   "孤燭異鄉春",
   "漸與骨肉遠",
   "轉於僮僕親",
   "那堪正漂泊",
   "明日歲華新"
  ]
 },
 {
  "title": "宮詞其一",
  "author": "張祜",
  "author_roman": "ZHANG HU",
  "author_dates": "785-849",
  "form": "五言絕句",
  "lines": [
   "故國三千里",
   "深宮二十年",
   "一聲河滿子",
   "雙淚落君前"
  ]
 },
 {
  "title": "溪居",
  "author": "柳宗元",
  "author_roman": "LIU ZONGYUAN",
  "author_dates": "773-819",
  "form": "五言古詩",
  "lines": [
   "久為簪組累",
   "幸此南夷謫",
   "閑依農圃鄰",
   "偶似山林客",
   "曉耕翻露草",
   "夜榜響溪石",
   "來往不逢人",
   "長歌楚天碧"
  ]
 },
 {
  "title": "江雪",
  "author": "柳宗元",
  "author_roman": "LIU ZONGYUAN",
  "author_dates": "773-819",
  "form": "五言絕句",
  "lines": [
   "千山鳥飛絕",
   "萬逕人蹤滅",
   "孤舟蓑笠翁",
   "獨釣寒江雪"
  ]
 },
 {
  "title": "蜀先主廟",
  "author": "劉禹錫",
  "author_roman": "LIU YUXI",
  "author_dates": "772-842",
  "form": "五言律詩",
  "lines": [
   "天地英雄氣",
   "千秋尚凜然",
   "勢分三足鼎",
   "業復五銖錢",
   "得相能開國",
   "生兒不象賢",
   "淒涼蜀故妓",
   "來舞魏宮前"
  ]
 },
 {
  "title": "月夜",
  "author": "杜甫",
  "author_roman": "DU FU",
  "author_dates": "712-770",
  "form": "五言律詩",
  "lines": [
   "今夜鄜州月",
   "閨中只獨看",
   "遙憐小兒女",
   "未解憶長安",
   "香霧雲鬟濕",
   "清輝玉臂寒",
   "何時倚虛幌",
   "雙照淚痕乾"
  ]
 },
 {
  "title": "春望",
  "author": "杜甫",
  "author_roman": "DU FU",
  "author_dates": "712-770",
  "form": "五言律詩",
  "lines": [
   "國破山河在",
   "城春草木深",
   "感時花濺淚",
   "恨別鳥驚心",
   "烽火連三月",
   "家書抵萬金",
   "白頭搔更短",
   "渾欲不勝簪"
  ]
 },
 {
  "title": "春宿左省",
  "author": "杜甫",
  "author_roman": "DU FU",
  "author_dates": "712-770",
  "form": "五言律詩",
  "lines": [
   "花隱掖垣暮",
   "啾啾棲鳥過",
   "星臨萬戶動",
   "月傍九霄多",
   "不寢聽金鑰",
   "因風想玉珂",
   "明朝有封事",
   "數問夜如何"
  ]
 },
 {
  "title": "月夜憶舍弟",
  "author": "杜甫",
  "author_roman": "DU FU",
  "author_dates": "712-770",
  "form": "五言律詩",
  "lines": [
   "戍鼓斷人行",
   "秋邊一雁聲",
   "露從今夜白",
   "月是故鄉明",
   "有弟皆分散",
   "無家問死生",
   "寄書長不避",
   "況乃未休兵"
  ]
 },
 {
  "title": "天末憶李白",
  "author": "杜甫",
  "author_roman": "DU FU",
  "author_dates": "712-770",
  "form": "五言律詩",
  "lines": [
   "涼風起天末",
   "君子意如何",
   "鴻雁幾時到",
   "江湖秋水多",
   "文章憎命達",
   "魑魅喜人過",
   "應共冤魂語",
   "投詩贈汩羅"
  ]
 },
 {
  "title": "奉濟驛重送嚴公四韻",
  "author": "杜甫",
  "author_roman": "DU FU",
  "author_dates": "712-770",
  "form": "五言律詩",
  "lines": [
   "遠送從此別",
   "青山空復情",
   "幾時桮重把",
   "昨夜月同行",
   "列郡謳歌惜",
   "三朝出入榮",
   "江村獨歸處",
   "寂寞養殘生"
  ]
 },
 {
  "title": "別房太尉墓",
  "author": "杜甫",
  "author_roman": "DU FU",
  "author_dates": "712-770",
  "form": "五言律詩",
  "lines": [
   "他鄉復行役",
   "駐馬別孤墳",
   "近淚無乾土",
   "低空有斷雲",
   "對碁陪謝傅",
   "把劍覓徐君",
   "唯見林花落",
   "鶯啼送客聞"
  ]
 },
 {
  "title": "旅夜書懷",
  "author": "杜甫",
  "author_roman": "DU FU",
  "author_dates": "712-770",
  "form": "五言律詩",
  "lines": [
   "細草微風岸",
   "危檣獨夜舟",
   "星垂平野闊",
   "月湧大江流",
   "名豈文章著",
   "官因老病休",
   "飄飄何所似",
   "天地一沙鷗"
  ]
 },
 {
  "title": "八陣圖",
  "author": "杜甫",
  "author_roman": "DU FU",
  "author_dates": "712-770",
  "form": "五言絕句",
  "lines": [
   "功蓋三分國",
   "名高八陣圖",
   "江流石不轉",
   "遺恨失吞吳"
  ]
 },
 {
  "title": "登岳陽樓",
  "author": "杜甫",
  "author_roman": "DU FU",
  "author_dates": "712-770",
  "form": "五言律詩",
  "lines": [
   "昔聞洞庭水",
   "今上岳陽樓",
   "吳楚東南坼",
   "乾坤日夜浮",
   "親朋無一字",
   "老病有孤舟",
   "戎馬關山北",
   "憑軒涕泗流"
  ]
 },
 {
  "title": "望月懷遠",
  "author": "張九齡",
  "author_roman": "ZHANG JIULING",
  "author_dates": "678-740",
  "form": "五言律詩",
  "lines": [
   "海上生明月",
   "天涯共此時",
   "情人怨遙夜",
   "竟夕起相思",
   "滅燭憐光滿",
   "披衣覺露滋",
   "不堪盈手贈",
   "還寢夢佳期"
  ]
 },
 {
  "title": "題大庾嶺北驛",
  "author": "宋之問",
  "author_roman": "SONG ZHIWEN",
  "author_dates": "656-712",
  "form": "五言律詩",
  "lines": [
   "陽月南飛雁",
   "傳聞至此回",
   "我行殊未已",
   "何日復歸來",
   "江靜潮初落",
   "林昏瘴不開",
   "明朝望鄉處",
   "應見隴頭梅"
  ]
 },
 {
  "title": "渡漢江",
  "author": "宋之問",
  "author_roman": "SONG ZHIWEN",
  "author_dates": "656-712",
  "form": "五言絕句",
  "lines": [
   "嶺外音書斷",
   "經冬復歷春",
   "近鄉情更怯",
   "不敢問來人"
  ]
 },
 {
  "title": "新年作",
  "author": "宋之問",
  "author_roman": "SONG ZHIWEN",
  "author_dates": "656-712",
  "form": "五言律詩",
  "lines": [
   "鄉心新歲切",
   "天畔獨潸然",
   "老至居人下",
   "春歸在客先",
   "嶺猨同旦暮",
   "江柳共風煙",
   "已似長沙傅",
   "從今又幾年"
  ]
 },
 {
  "title": "杜少府之任蜀州",
  "author": "王勃",
  "author_roman": "WANG BO",
  "author_dates": "650-676",
  "form": "五言律詩",
  "lines": [
   "城闕輔三秦",
   "風煙望五津",
   "與君離別意",
   "同是宦遊人",
   "海內存知己",
   "天涯若比隣",
   "無為在岐路",
   "兒女共霑巾"
  ]
 },
 {
  "title": "和晉陵陸丞早春遊望",
  "author": "杜審言",
  "author_roman": "DU SHENYAN",
  "author_dates": "645-708",
  "form": "五言律詩",
  "lines": [
   "獨有宦遊人",
   "偏驚物候新",
   "雲霞出海曙",
   "梅柳渡江春",
   "淑氣催黃鳥",
   "晴光轉綠蘋",
   "忽聞歌古調",
   "歸思欲霑巾"
  ]
 },
 {
  "title": "登樓",
  "author": "朱斌",
  "author_roman": "",
  "author_dates": "",
  "form": "五言絕句",
  "lines": [
   "白日依山盡",
   "黃河入海流",
   "欲窮千里目",
   "更上一層樓"
  ]
 },
 {
  "title": "望嶽",
  "author": "杜甫",
  "author_roman": "DU FU",
  "author_dates": "712-770",
  "form": "五言古詩",
  "lines": [
   "岱宗夫如何",
   "齊魯青未了",
   "造化鍾神秀",
   "陰陽割昏曉",
   "盪胸生曾雲",
   "決眥入歸鳥",
   "會當凌絕頂",
   "一覽眾山小"
  ]
 },
 {
  "title": "感遇其一",
  "author": "張九齡",
  "author_roman": "ZHANG JIULING",
  "author_dates": "678-740",
  "form": "五言古詩",
  "lines": [
   "蘭葉春葳蕤",
   "桂華秋皎潔",
   "欣欣此生意",
   "自爾為佳節",
   "誰知林棲者",
   "聞風坐相悅",
   "草木有本心",
   "何求美人折"
  ]
 },
 {
  "title": "感遇其二",
  "author": "張九齡",
  "author_roman": "ZHANG JIULING",
  "author_dates": "678-740",
  "form": "五言古詩",
  "lines": [
   "幽林歸獨臥",
   "滯慮洗孤清",
   "持此謝高鳥",
   "因之傳遠情",
   "日夕懷空意",
   "人誰感至精",
   "飛沈理自隔",
   "何所慰吾誠"
  ]
 },
 {
  "title": "尋陸鴻漸不遇",
  "author": "皎然",
  "author_roman": "JIAORAN",
  "author_dates": "730-799",
  "form": "五言律詩",
  "lines": [
   "移家雖帶郭",
   "野徑入桑麻",
   "近種籬邊菊",
   "秋來未著花",
   "扣門無犬吠",
   "欲去問西家",
   "報道山中去",
   "歸時每日斜"
  ]
 },
 {
  "title": "谷口書齋寄楊補闕",
  "author": "錢起",
  "author_roman": "QIAN QI",
  "author_dates": "722-780",
  "form": "五言律詩",
  "lines": [
   "泉壑帶茅茨",
   "雲霞生薜帷",
   "竹憐新雨後",
   "山愛夕陽時",
   "閑鷺棲常早",
   "秋花落更遲",
   "家童掃蘿逕",
   "昨與故人期"
  ]
 },
 {
  "title": "送僧歸日本",
  "author": "錢起",
  "author_roman": "QIAN QI",
  "author_dates": "722-780",
  "form": "五言律詩",
  "lines": [
   "上國隨緣住",
   "來途若夢行",
   "浮天滄海遠",
   "去世法舟輕",
   "水月通禪觀",
   "魚龍聽梵聲",
   "惟憐一燈影",
   "萬里眼中明"
  ]
 },
 {
  "title": "和張僕射塞下曲",
  "author": "錢起",
  "author_roman": "QIAN QI",
  "author_dates": "722-780",
  "form": "樂府",
  "lines": [
   "月黑雁飛高",
   "單于夜遁逃",
   "欲將輕騎逐",
   "大雪滿弓刀"
  ]
 },
 {
  "title": "酬程延秋夜即事見贈",
  "author": "韓翃",
  "author_roman": "",
  "author_dates": "",
  "form": "五言律詩",
  "lines": [
   "長簟迎風早",
   "空城澹月華",
   "星河秋一雁",
   "砧杵夜千家",
   "節候看應晚",
   "心期臥亦賒",
   "向來吟秀句",
   "不覺已鳴鴉"
  ]
 },
 {
  "title": "寄全椒山中道士",
  "author": "韋應物",
  "author_roman": "WEI YINGWU",
  "author_dates": "737-792",
  "form": "五言古詩",
  "lines": [
   "今朝郡齋冷",
   "忽念山中客",
   "澗底束荊薪",
   "歸來煮白石",
   "欲持一瓢酒",
   "遠慰風雨夕",
   "落葉滿空山",
   "何處尋行跡"
  ]
 },
 {
  "title": "秋夜寄丘二十二員外",
  "author": "韋應物",
  "author_roman": "WEI YINGWU",
  "author_dates": "737-792",
  "form": "五言絕句",
  "lines": [
   "懷君屬秋夜",
   "散步詠涼天",
   "山空松子落",
   "幽人應未眠"
  ]
 },
 {
  "title": "賦得暮雨送李胄",
  "author": "韋應物",
  "author_roman": "WEI YINGWU",
  "author_dates": "737-792",
  "form": "五言律詩",
  "lines": [
   "楚江微雨裏",
   "建業暮鐘時",
   "漠漠帆來重",
   "冥冥鳥去遲",
   "海門深不見",
   "浦樹遠含滋",
   "相送情無限",
   "沾襟比散絲"
  ]
 },
 {
  "title": "長安遇馮著",
  "author": "韋應物",
  "author_roman": "WEI YINGWU",
  "author_dates": "737-792",
  "form": "五言古詩",
  "lines": [
   "客從東方來",
   "衣上灞陵雨",
   "問客何為來",
   "采山因買斧",
   "冥冥花正開",
   "颺颺燕新乳",
   "昨別今已春",
   "鬢絲生幾縷"
  ]
 },
 {
  "title": "夕次盱眙縣",
  "author": "韋應物",
  "author_roman": "WEI YINGWU",
  "author_dates": "737-792",
  "form": "五言古詩",
  "lines": [
   "落帆逗淮鎮",
   "停舫臨孤驛",
   "浩浩風起波",
   "冥冥日沈夕",
   "人歸山郭暗",
   "雁下蘆洲白",
   "獨夜憶秦關",
   "聽鐘未眠客"
  ]
 },
 {
  "title": "和晉陵陸丞早春遊望",
  "author": "韋應物",
  "author_roman": "WEI YINGWU",
  "author_dates": "737-792",
  "form": "五言律詩",
  "lines": [
   "獨有宦遊人",
   "偏驚物候新",
   "雲霞出海曙",
   "梅柳渡江春",
   "淑氣催黃鳥",
   "晴光照綠蘋",
   "忽聞歌苦調",
   "歸思欲霑巾"
  ]
 },
 {
  "title": "寄左省杜拾遺",
  "author": "岑參",
  "author_roman": "CEN SHEN",
  "author_dates": "715-770",
  "form": "五言律詩",
  "lines": [
   "聯步趨丹陛",
   "分曹限紫微",
   "曉隨天仗入",
   "暮惹御香歸",
   "白髮悲花落",
   "青雲羨鳥飛",
   "聖朝無闕事",
   "自覺諫書稀"
  ]
 },
 {
  "title": "訪羊尊師",
  "author": "孫革",
  "author_roman": "",
  "author_dates": "",
  "form": "五言絕句",
  "lines": [
   "松下問童子",
   "言師採藥去",
   "只在此山中",
   "雲深不知處"
  ]
 },
 {
  "title": "書邊事",
  "author": "張喬",
  "author_roman": "",
  "author_dates": "",
  "form": "五言律詩",
  "lines": [
   "調角斷清秋",
   "征人倚戍樓",
   "春風對青塚",
   "白日落梁州",
   "大漢無兵阻",
   "窮邊有客遊",
   "蕃情似此水",
   "長願向南流"
  ]
 },
 {
  "title": "玉階怨",
  "author": "李白",
  "author_roman": "LI BAI",
  "author_dates": "701-762",
  "form": "樂府",
  "lines": [
   "玉階生白露",
   "夜久侵羅襪",
   "却下水晶簾",
   "玲瓏望秋月"
  ]
 },
 {
  "title": "靜夜思",
  "author": "李白",
  "author_roman": "LI BAI",
  "author_dates": "701-762",
  "form": "五言絕句",
  "lines": [
   "牀前看月光",
   "疑是地上霜",
   "舉頭望山月",
   "低頭思故鄉"
  ]
 },
 {
  "title": "贈孟浩然",
  "author": "李白",
  "author_roman": "LI BAI",
  "author_dates": "701-762",
  "form": "五言律詩",
  "lines": [
   "吾愛孟夫子",
   "風流天下聞",
   "紅顏棄軒冕",
   "白首臥松雲",
   "醉月頻中聖",
   "迷花不事君",
   "高山安可仰",
   "徒此揖清芬"
  ]
 },
 {
  "title": "渡荊門送別",
  "author": "李白",
  "author_roman": "LI BAI",
  "author_dates": "701-762",
  "form": "五言律詩",
  "lines": [
   "渡遠荊門外",
   "來從楚國遊",
   "山隨平野盡",
   "江入大荒流",
   "月下飛天鏡",
   "雲生結海樓",
   "仍連故鄉水",
   "萬里送行舟"
  ]
 },
 {
  "title": "送友人",
  "author": "李白",
  "author_roman": "LI BAI",
  "author_dates": "701-762",
  "form": "五言律詩",
  "lines": [
   "青山橫北郭",
   "白水遶東城",
   "此地一為別",
   "孤蓬萬里征",
   "浮雲遊子意",
   "落日故人情",
   "揮手自茲去",
   "蕭蕭班馬鳴"
  ]
 },
 {
  "title": "夜泊牛渚懷古",
  "author": "李白",
  "author_roman": "LI BAI",
  "author_dates": "701-762",
  "form": "五言律詩",
  "lines": [
   "牛渚西江夜",
   "青天無片雲",
   "登舟望秋月",
   "空憶謝將軍",
   "余亦能高詠",
   "斯人不可聞",
   "明朝挂帆席",
   "楓葉落紛紛"
  ]
 },
 {
  "title": "聽蜀僧濬彈琴",
  "author": "李白",
  "author_roman": "LI BAI",
  "author_dates": "701-762",
  "form": "五言律詩",
  "lines": [
   "蜀僧抱綠綺",
   "西下峨眉峰",
   "為我一揮手",
   "如聽萬壑松",
   "客心洗流水",
   "餘響入霜鐘",
   "不覺碧山暮",
   "秋雲暗幾重"
  ]
 },
 {
  "title": "怨情",
  "author": "李白",
  "author_roman": "LI BAI",
  "author_dates": "701-762",
  "form": "五言絕句",
  "lines": [
   "美人捲珠簾",
   "深坐顰蛾眉",
   "但見淚痕濕",
   "不知心恨誰"
  ]
 },
 {
  "title": "淮上喜會梁川故人",
  "author": "韋應物",
  "author_roman": "WEI YINGWU",
  "author_dates": "737-792",
  "form": "五言律詩",
  "lines": [
   "江漢曾為客",
   "相逢每醉還",
   "浮雲一別後",
   "流水十年間",
   "歡笑情如舊",
   "蕭疎鬢已斑",
   "何因北歸去",
   "淮上對秋山"
  ]
 },
 {
  "title": "初發揚子寄元大校書",
  "author": "韋應物",
  "author_roman": "WEI YINGWU",
  "author_dates": "737-792",
  "form": "五言古詩",
  "lines": [
   "悽悽去親愛",
   "泛泛入煙霧",
   "歸棹洛陽人",
   "殘鐘廣陵樹",
   "今朝此為別",
   "何處還相遇",
   "世事波上舟",
   "沿洄安得住"
  ]
 },
 {
  "title": "江南曲",
  "author": "李益",
  "author_roman": "LI YI",
  "author_dates": "748-829",
  "form": "樂府",
  "lines": [
   "嫁得瞿塘賈",
   "朝朝誤妾期",
   "早知潮有信",
   "嫁與弄潮兒"
  ]
 },
 {
  "title": "玉階怨",
  "author": "李白",
  "author_roman": "LI BAI",
  "author_dates": "701-762",
  "form": "樂府",
  "lines": [
   "玉階生白露",
   "夜久侵羅襪",
   "却下水精簾",
   "玲瓏望秋月"
  ]
 },
 {
  "title": "長干曲其一",
  "author": "崔顥",
  "author_roman": "CUI HAO",
  "author_dates": "704-754",
  "form": "樂府",
  "lines": [
   "君家定何處",
   "妾住在橫塘",
   "停舟暫借問",
   "或恐是同鄉"
  ]
 },
 {
  "title": "長干曲其二",
  "author": "崔顥",
  "author_roman": "CUI HAO",
  "author_dates": "704-754",
  "form": "樂府",
  "lines": [
   "家臨九江水",
   "去來九江側",
   "同是長干人",
   "生小不相識"
